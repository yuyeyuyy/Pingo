{
  "name": "pingo",
  "productName": "Pingo",
  "version": "0.1.0",
  "private": true,
  "description": "本地优先的桌面学习工具",
  "main": "./out/main/index.js",
  "engines": {
    "node": "^24.14.0"
  },
  "scripts": {
    "dev": "electron-vite dev --watch",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.domain.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "electron-vite build",
    "package:mac": "npm run build && electron-packager . Pingo --platform=darwin --icon=assets/pingo.icns --out=dist --overwrite --asar --ignore='^/(?!out(?:/|$)|package[.]json$)'"
  },
  "dependencies": {
    "lucide-react": "0.577.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@eslint/js": "10.0.1",
    "@types/node": "24.12.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.11.4",
    "electron-vite": "5.0.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "7.3.8",
    "vitest": "4.1.12"
  }
}
